{
  "name": "fence-launch-readiness",
  "version": "0.1.0",
  "tests": [
    {
      "name": "Fence version command succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../f* && kujo run *.kujo -- version"
      }
    },
    {
      "name": "Fence static check succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../f* && kujo check *.kujo"
      }
    },
    {
      "name": "Fence test harness succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "cd ../f* && kujo run tests/*_tests.kujo"
      }
    },
    {
      "name": "Fence config exists",
      "check": "command_succeeds",
      "params": {
        "command": "test -f ../f*/f*.toml"
      }
    }
  ]
}
