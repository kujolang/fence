// src/util.kujo
// Small shared helpers used across Fence modules.
//
// These exist because Kujo's builtin predicates are not perfectly uniform
// (string `contains` returns 1/0 while array `contains` returns a bool, etc.)
// and because Fence avoids deep call chains by keeping helpers leaf-like.

// Coerce any Kujo "truthy-ish" value (1, 0, true, false) into a real bool.
export func truthy(v) {
    if v == true {
        return true
    }
    if v == 1 {
        return true
    }
    return false
}

// True when array `arr` contains the string `needle`.
// Uses index scanning so behaviour is identical regardless of builtin quirks.
export func arr_has(arr, needle) {
    let n = len(arr)
    mut i = 0
    while i < n {
        if arr[i] == needle {
            return true
        }
        i = i + 1
    }
    return false
}

// True when the dictionary `d` has the given key.
export func dict_has(d, key) {
    return truthy(has_key(d, key))
}

// Return d[key] if present, else fallback.
export func dict_get(d, key, fallback) {
    if truthy(has_key(d, key)) {
        return d[key]
    }
    return fallback
}

// Deterministic ascending string sort. Delegates to the native `sort` builtin
// (O(n log n)); a stable, correct order is all Fence needs for reproducible
// reports.
export func sort_strings(arr) {
    return sort(arr)
}

// Join an array of strings with a separator, using single-string accumulation
// (avoids the push+join allocation pattern that can crash the VM in hot paths).
export func join_strings(arr, sep) {
    let n = len(arr)
    if n == 0 {
        return ""
    }
    mut out = arr[0]
    mut i = 1
    while i < n {
        out = out + sep + arr[i]
        i = i + 1
    }
    return out
}

// Count occurrences of needle in arr.
export func count_in(arr, needle) {
    let n = len(arr)
    mut c = 0
    mut i = 0
    while i < n {
        if arr[i] == needle {
            c = c + 1
        }
        i = i + 1
    }
    return c
}
