// src/cliargs.kujo
// Minimal command-line parsing for Fence.
//
// Produces { command, positionals[], flags{} }. Flags accept the forms:
//   --name value     -> flags["name"] = "value"
//   --name=value     -> flags["name"] = "value"
//   --flag           -> flags["flag"] = "true"   (when not followed by a value)
// Known value-flags are passed in so booleans are not greedily consumed.

from src.util import dict_has
from cli import parse

// value_flags: array of flag names that always take a following value.
export func parse_args(argv, value_flags) {
    mut spec = []
    for name in value_flags {
        spec = append(spec, {"name": name, "kind": "string", "allow_empty": true})
    }
    for name in ["baseline", "changed-only", "quiet", "summary-only", "cycles", "force"] {
        spec = append(spec, {"name": name, "kind": "bool"})
    }
    let parsed = parse(argv, spec)
    if parsed["ok"] != true {
        return {"command": "", "positionals": [], "flags": {}, "error": parsed["error"]["message"]}
    }
    let value = parsed["value"]
    mut flags = {}
    for occurrence in value["occurrences"] {
        flags[occurrence["name"]] = occurrence["value"]
    }
    return {
        "command": value["command"],
        "positionals": value["positionals"],
        "flags": flags
    }
}

// Convenience: flag value or fallback.
export func flag_or(flags, name, fallback) {
    if dict_has(flags, name) {
        return flags[name]
    }
    return fallback
}

// Convenience: is a boolean flag present (any value)?
export func has_flag(flags, name) {
    return dict_has(flags, name)
}
